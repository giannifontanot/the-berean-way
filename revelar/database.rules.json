{
  "rules": {
    "revelar": {
      "$sesion": {
        ".read": true,
        "reveladas": {
          ".write": "auth != null && auth.uid === 'xWkkWXXR0jcHMnOGEwYjrxzxGtX2'",
          "$foto": {
            ".validate": "newData.isNumber()"
          }
        },
        "orden": {
          ".write": "auth != null && auth.uid === 'xWkkWXXR0jcHMnOGEwYjrxzxGtX2'",
          "$i": {
            ".validate": "newData.isString()"
          }
        },
        "escrituras": {
          ".write": "auth != null && auth.uid === 'xWkkWXXR0jcHMnOGEwYjrxzxGtX2'",
          "$e": {
            ".validate": "newData.hasChildren(['texto'])",
            "cita": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "texto": {
              ".validate": "newData.isString() && newData.val().length <= 4000"
            },
            "todoRojo": {
              ".validate": "newData.isBoolean()"
            },
            "creado": {
              ".validate": "newData.isNumber()"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "subidas": {
          ".write": "auth != null && auth.uid === 'xWkkWXXR0jcHMnOGEwYjrxzxGtX2'",
          "$f": {
            ".validate": "newData.hasChildren(['src'])",
            "src": {
              ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 2000000"
            },
            "creado": {
              ".validate": "newData.isNumber()"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "presencia": {
          "$conexion": {
            ".write": true,
            ".validate": "newData.val() === true"
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "revelar_privado": {
      "$sesion": {
        ".read": "auth != null && auth.uid === 'xWkkWXXR0jcHMnOGEwYjrxzxGtX2'",
        ".write": "auth != null && auth.uid === 'xWkkWXXR0jcHMnOGEwYjrxzxGtX2'",
        "notas": {
          "$n": {
            ".validate": "newData.isString() && newData.val().length <= 4000"
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    }
  }
}
