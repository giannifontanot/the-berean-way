{
  "rules": {
    "revelar": {
      "$sesion": {
        ".read": true,
        "reveladas": {
          ".write": "auth != null && root.child('revelar_duenos/' + $sesion).val() === auth.uid && !root.child('revelar_bloqueados/' + auth.uid).exists()",
          "$foto": {
            ".validate": "newData.isNumber()"
          }
        },
        "orden": {
          ".write": "auth != null && root.child('revelar_duenos/' + $sesion).val() === auth.uid && !root.child('revelar_bloqueados/' + auth.uid).exists()",
          "$i": {
            ".validate": "newData.isString()"
          }
        },
        "escrituras": {
          ".write": "auth != null && root.child('revelar_duenos/' + $sesion).val() === auth.uid && !root.child('revelar_bloqueados/' + auth.uid).exists()",
          "$e": {
            ".validate": "newData.hasChildren(['texto'])",
            "cita": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "texto": {
              ".validate": "newData.isString() && newData.val().length <= 4000"
            },
            "todoRojo": {
              ".validate": "newData.isBoolean()"
            },
            "creado": {
              ".validate": "newData.isNumber()"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "subidas": {
          ".write": "auth != null && root.child('revelar_duenos/' + $sesion).val() === auth.uid && !root.child('revelar_bloqueados/' + auth.uid).exists()",
          "$f": {
            ".validate": "newData.hasChildren(['src'])",
            "src": {
              ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 2000000"
            },
            "creado": {
              ".validate": "newData.isNumber()"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "presencia": {
          "$conexion": {
            ".write": true,
            ".validate": "newData.val() === true"
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "revelar_privado": {
      "$sesion": {
        ".read": "auth != null && root.child('revelar_duenos/' + $sesion).val() === auth.uid",
        ".write": "auth != null && root.child('revelar_duenos/' + $sesion).val() === auth.uid && !root.child('revelar_bloqueados/' + auth.uid).exists()",
        "notas": {
          "$n": {
            ".validate": "newData.isString() && newData.val().length <= 4000"
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "revelar_duenos": {
      "$sesion": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid) && !root.child('revelar_bloqueados/' + auth.uid).exists()",
        ".validate": "newData.isString() && newData.val().length <= 128"
      }
    },
    "revelar_lecciones": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !root.child('revelar_bloqueados/' + auth.uid).exists()",
        "$leccion": {
          "titulo": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "creada": {
            ".validate": "newData.isNumber()"
          },
          "editada": {
            ".validate": "newData.isNumber()"
          },
          "archivada": {
            ".validate": "newData.isBoolean()"
          },
          "laminas": {
            ".validate": "newData.isNumber()"
          },
          "portada": {
            ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 100000"
          },
          "$otro": {
            ".validate": false
          }
        }
      }
    },
    "revelar_maestros": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "codigo": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "nombre": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "creado": {
          ".validate": "newData.isNumber()"
        },
        "$otro": {
          ".validate": false
        },
        "lecciones": {
          ".validate": "newData.isNumber()"
        },
        "activo": {
          ".validate": "newData.isNumber()"
        },
        "correo": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        }
      },
      ".read": "auth != null && auth.uid === 'xWkkWXXR0jcHMnOGEwYjrxzxGtX2'"
    },
    "revelar_codigos": {
      "$codigo": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid && !root.child('revelar_bloqueados/' + auth.uid).exists()",
        ".validate": "newData.isString() && $codigo.matches(/^[a-z0-9]{4,8}$/)"
      }
    },
    "revelar_vivo": {
      "$codigo": {
        ".read": true,
        ".write": "(auth != null && root.child('revelar_codigos/' + $codigo).val() === auth.uid && !root.child('revelar_bloqueados/' + auth.uid).exists()) || (auth != null && auth.uid === 'xWkkWXXR0jcHMnOGEwYjrxzxGtX2')",
        ".validate": "newData.isString() && newData.val().length <= 40"
      }
    },
    "revelar_actual": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'xWkkWXXR0jcHMnOGEwYjrxzxGtX2'",
      ".validate": "newData.isString() && newData.val().length <= 40"
    },
    "revelar_buzon": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$envio": {
          ".write": "auth != null && ((!data.exists() && newData.child('deUid').val() === auth.uid && !root.child('revelar_bloqueados/' + auth.uid).exists()) || (auth.uid === $uid && !newData.exists()))",
          ".validate": "newData.hasChildren(['deUid', 'origen', 'titulo'])",
          "deUid": {
            ".validate": "newData.isString()"
          },
          "deNombre": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "origen": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "titulo": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "creado": {
            ".validate": "newData.isNumber()"
          },
          "$otro": {
            ".validate": false
          }
        }
      }
    },
    "revelar_bloqueados": {
      ".read": "auth != null && auth.uid === 'xWkkWXXR0jcHMnOGEwYjrxzxGtX2'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'xWkkWXXR0jcHMnOGEwYjrxzxGtX2')",
        ".write": "auth != null && auth.uid === 'xWkkWXXR0jcHMnOGEwYjrxzxGtX2'",
        ".validate": "newData.val() === true"
      }
    }
  }
}
