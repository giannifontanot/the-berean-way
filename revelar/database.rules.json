{
  "rules": {
    "revelar": {
      "$sesion": {
        ".read": true,
        "reveladas": {
          ".write": "auth != null && auth.uid === 'xWkkWXXR0jcHMnOGEwYjrxzxGtX2'",
          "$foto": {
            ".validate": "newData.isNumber()"
          }
        },
        "presencia": {
          "$conexion": {
            ".write": true,
            ".validate": "newData.val() === true"
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    }
  }
}
